# ─── Database reset ──────────────────────────────────────────────────────────
# Set to "true" to drop and recreate the database from schema.sql on startup.
# Never use in production. Useful for local dev and CI.
DB_RESET_SCHEMA=false

# ─── MySQL ───────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hotel_user
DB_PASSWORD=change_me
DB_NAME=hotel_db

# ─── Redis ───────────────────────────────────────────────────────────────────
# REDIS_ADDR accepts host:port format
REDIS_ADDR=127.0.0.1:6379
# Leave empty if Redis has no auth
REDIS_PASSWORD=
# 0-indexed logical database number (0–15)
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_to_a_long_random_secret

# ─── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=8040

# ─── CORS ────────────────────────────────────────────────────────────────────
# Origin allowed to call the API. Defaults to http://localhost:3040 if unset.
CORS_ORIGIN=http://localhost:3040
